# Copy to .env (git-ignored). Every variable, its type and its default is
# declared in internal/config/config.go.

# --- Application ------------------------------------------------------------
# dev | test | staging | production
APP_ENV=dev
# debug | info | warn | error
LOG_LEVEL=debug
# json in deployed environments
LOG_FORMAT=text

# --- HTTP -------------------------------------------------------------------
HTTP_ADDR=:8080
# /metrics and /debug/pprof; empty disables it
ADMIN_ADDR=127.0.0.1:9090
# HTTP_REQUEST_TIMEOUT=20s
# HTTP_SHUTDOWN_DELAY=5s    # set in Kubernetes so endpoints drain before shutdown
# HTTP_HSTS=true            # only behind HTTPS

# --- Database (required) ----------------------------------------------------
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# DATABASE_MAX_CONNS=10
# DATABASE_AUTO_MIGRATE=true  # dev convenience; forbidden in production

# --- Redis (optional: in-memory cache when empty) ---------------------------
# REDIS_URL=redis://localhost:6379/0

# --- Authentication ---------------------------------------------------------
# dev: the bearer token is the user id, e.g. "Authorization: Bearer alice"
#      or "alice:admin" to add roles. Refused outside APP_ENV=dev|test.
AUTH_MODE=dev
# jwt: any OIDC provider. Firebase Auth example:
# AUTH_MODE=jwt
# AUTH_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
# AUTH_ISSUER=https://securetoken.google.com/<firebase-project-id>
# AUTH_AUDIENCE=<firebase-project-id>
# AUTH_ROLES_CLAIM=roles

# --- CORS / rate limiting -----------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
# RATE_LIMIT_RPS=10          # 0 disables the limiter
# RATE_LIMIT_BURST=30
# RATE_LIMIT_TRUSTED_PROXIES=10.0.0.0/8

# --- API docs (/docs) ---------------------------------------------------------
DOCS_ENABLED=true
# DOCS_USER=ops              # basic auth; required in production when enabled
# DOCS_PASSWORD=change-me

# --- Integration tests ----------------------------------------------------------
# Server used by `make test-integration` instead of a testcontainers container.
# TEST_DATABASE_URL=postgres://app:app@localhost:5432/postgres?sslmode=disable
